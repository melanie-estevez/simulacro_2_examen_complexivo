            },
            "body": { "mode": "raw", "raw": "{\n  \"cost\": 45,\n  \"notes\": \"Actualizado\"\n}" }
          }
        },
        {
          "name": "Delete flight events service (Auth) - DELETE /api/flight-events/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/flight-events/{{flightEventId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flight-events", "{{flightEventId}}", ""]
            }
          }
        }
      ]
    }
  ]
}