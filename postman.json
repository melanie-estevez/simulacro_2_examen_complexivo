              "raw": "{\n  \"flight_id\": 1,\n  \"airline_id\": \"{{airlineId}}\",\n  \"source\": web,\n  \"note\": ninguna novedad,\n }"
            }
          }
        },
        {
          "name": "Get flight events service by id (Auth) - GET /api/flight-events/:id",
          "request": {
